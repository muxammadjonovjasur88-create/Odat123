rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /music/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /books/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /audiobooks/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /releases/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /shop/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    // Boshqa barcha fayllar (public read)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
