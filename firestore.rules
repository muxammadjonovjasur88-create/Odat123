rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
    }

    // Clans collection
    match /clans/{clanId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Music, Books, Audiobooks & Shop items
    match /music_tracks/{trackId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /audiobooks/{audiobookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Telegram Login requests
    match /loginRequests/{tokenId} {
      allow create, read, update, delete: if true;
    }

    // Telegram OTP Codes
    match /telegramAuthCodes/{code} {
      allow read, update: if true;
    }

    // Battles, Active Runners, Territories & Proof Sessions
    match /battles/{battleId} {
      allow read, write: if request.auth != null;
    }
    match /active_runners/{runnerId} {
      allow read, write: if request.auth != null;
    }
    match /territories/{territoryId} {
      allow read, write: if request.auth != null;
    }
    match /proofSessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /security_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read: if false;
    }
    match /family_goals/{goalId} {
      allow read, write: if request.auth != null;
    }

    // Default closed fallback (CRITICAL-01 resolved)
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

