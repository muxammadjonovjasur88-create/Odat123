rules_version = '2';

// Flowa Firestore security rules.
//
// * Any signed-in user can READ user profile documents — this powers the
//   Community / Growth Circle leaderboard (screen 16), where everyone sees
//   each other's points. Only the owner may WRITE their own profile.
// * Tasks and daily stats under a user are fully private to that user.
// * likedBy subcollection tracks which users have liked a profile.
// * proofSessions: owner reads/writes freely; a user in the session owner's
//   `sharedWith` list can read (but NOT write) the session — this powers the
//   "Friends' Proofs" screen (Qism 3 Bosqich B).
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore Database → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;

      // Owner can write anything to their own profile.
      allow write: if request.auth != null && request.auth.uid == uid;

      // Any authenticated user can update ONLY the likesCount field
      // (used by toggleLike when incrementing/decrementing the counter
      // on another user's profile document).
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']);

      // sharedWith: allow a friend to add themselves (addFriend method updates
      // both documents in a batch — the Cloud SDK call is authenticated as the
      // requesting user so we allow arrayUnion of the caller's own uid).
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith']);

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /daily/{dayId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // likedBy: tracks which users have liked this user's profile
      match /likedBy/{likerUserId} {
        // Signed-in users can read the list of likers (for UI state)
        allow read: if request.auth != null;
        // Only the liker can add/remove their own like
        allow create: if request.auth != null && request.auth.uid == likerUserId;
        allow delete: if request.auth != null && request.auth.uid == likerUserId;
      }
    }

    // ---------------------------------------------------------------------------
    // proofSessions — Tasodifiy Isbot sessiyalari
    //
    // Egasi (userId == request.auth.uid): to'liq huquq
    // Do'st (request.auth.uid in resource.data.sharedWithReaders): faqat o'qish
    //
    // ESLATMA: sharedWithReaders maydoni Cloud Function (scheduleRandomProofs)
    // tomonidan yaratilayotganda session'ga ownerning sharedWith ro'yxatidan
    // nusxalanib saqlanadi. Bu Rules'da getAfter() yoki get() istifodasi
    // o'rniga, sessionga yozilgan cached ro'yxat bo'lib xizmat qiladi
    // (cross-collection query Rules'da mumkin emas).
    //
    // Agar scheduleRandomProofs funksiyasi sharedWithReaders ni yozmasa,
    // fallback sifatida eganing users/{userId}.sharedWith ni serverdan o'qib
    // tekshiramiz (get() orqali — kichik qo'shimcha narx).
    // ---------------------------------------------------------------------------
    match /proofSessions/{sessionId} {
      // Egasi to'liq huquqqa ega
      allow read, write: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Yangi sessiya yaratish — faqat authenticated user o'z nomidan
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Do'st o'qishi — agar eganing sharedWith ro'yxatida caller bor bo'lsa
      allow read: if request.auth != null
        && request.auth.uid != resource.data.userId
        && request.auth.uid in get(
            /databases/$(database)/documents/users/$(resource.data.userId)
          ).data.sharedWith;
    }

    // Private competition lobbies. Any signed-in user can read (needed to find
    // a lobby by join code) and join/leave (which updates memberUids). The
    // member cap is enforced here too. Tighten further for production if needed.
    match /lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 20;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids || request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 20;
      allow delete: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    }
  }
}
